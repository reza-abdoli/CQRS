@model UI.Models.CreateLeaveTypeVM

@{
    ViewData["Title"] = "ایجاد نوع مرخصی";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-plus me-2"></i>
                        ایجاد نوع مرخصی جدید
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateLeaveTypes" asp-controller="LeaveType" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">نام نوع مرخصی</label>
                            <input asp-for="Name" class="form-control" placeholder="مثلاً: مرخصی استعلاجی" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DefaultDay" class="form-label"></label>
                            <input asp-for="DefaultDay" type="number" class="form-control" placeholder="تعداد روز پیش‌فرض" />
                            <span asp-validation-for="DefaultDay" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-area="" asp-controller="LeaveType" asp-action="LeaveTypes" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-right me-1"></i>
                                بازگشت
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                ذخیره
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}