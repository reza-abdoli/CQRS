@model UI.Models.LoginVM

@{
    ViewData["Title"] = "ورود به سیستم";
    Layout = "_Layout"; // اگه لایه‌ی جدا برای صفحات auth دارید؛ در غیر این‌صورت حذفش کنید
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-dark">
    <div class="col-11 col-sm-8 col-md-5 col-lg-4">
        <div class="card bg-black bg-opacity-75 border-secondary shadow-lg text-white">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle display-4 text-primary"></i>
                    <h4 class="mt-2 mb-0">ورود به سیستم</h4>
                    <p class="text-muted small">برای ادامه وارد حساب کاربری خود شوید</p>
                </div>

                <form asp-action="Login" asp-controller="Users" method="post">
                    <input type="hidden" name="returnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">ایمیل</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-white border-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control bg-transparent text-white border-secondary"
                                   placeholder="example@email.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-white border-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" class="form-control bg-transparent text-white border-secondary"
                                   placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        <i class="bi bi-box-arrow-in-left me-1"></i>
                        ورود
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}